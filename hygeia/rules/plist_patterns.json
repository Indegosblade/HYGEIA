{
  "_comment": "HYGEIA plist sanitization patterns — paths containing credential plists",
  "sanitize_paths": [
    "/mobile/Library/Preferences/",
    "/mobile/Containers/Data/Application/",
    "/root/Library/Lockdown/",
    "/wireless/Library/Preferences/"
  ],
  "always_sanitize_files": [
    "com.apple.identityservices.idstatuscache.plist",
    "com.apple.mobilephone.plist",
    "data_ark.plist",
    "com.apple.commcenter.data.plist"
  ],
  "never_sanitize_files": [
    "com.apple.security.plist",
    "com.apple.LaunchServices.plist",
    "com.apple.mobile.installation.plist"
  ],
  "redact_all_values_files": [
    "data_ark.plist",
    "com.apple.MobileGestalt.plist",
    "com.apple.purplebuddy.plist",
    "com.apple.mobileactivationd.plist"
  ],
  "sensitive_key_patterns": [
    "email", "token", "auth", "password", "phone",
    "login", "user", "account", "credential",
    "oauth", "bearer", "session", "cookie",
    "secret", "apikey", "api_key", "refresh",
    "access_token", "id_token", "username",
    "firstname", "lastname", "fullname",
    "icloud", "appleid", "imei", "iccid", "imsi"
  ]
}
