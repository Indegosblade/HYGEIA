{
  "_comment": "HYGEIA deletion rules â€” paths and patterns for personal data removal",
  "directory_patterns": [
    "/mobile/Library/SMS/",
    "/mobile/Media/DCIM/",
    "/mobile/Media/PhotoData/",
    "/mobile/Media/Photos/",
    "/mobile/Media/Recordings/",
    "/mobile/Library/AddressBook/",
    "/mobile/Library/CallHistoryDB/",
    "/mobile/Library/Safari/",
    "/mobile/Library/Mail/",
    "/mobile/Library/Voicemail/",
    "/mobile/Library/Health/",
    "/mobile/Library/Calendar/",
    "/mobile/Library/Notes/",
    "/mobile/Library/Accounts/",
    "/mobile/Library/Cookies/",
    "/mobile/Library/WebKit/",
    "/mobile/Library/Caches/com.apple.Safari/",
    "/mobile/Library/Caches/Snapshots/",
    "/mobile/Library/Biome/",
    "/mobile/Library/CoreDuet/People/",
    "/mobile/Library/Passes/",
    "/mobile/Library/Assistant/",
    "/mobile/Library/Keyboard/",
    "/mobile/Library/Application Support/com.apple.remotemanagementd/",
    "/mobile/Documents/",
    "/mobile/Downloads/",
    "/root/Library/Caches/locationd/",
    "/mobile/Library/Caches/com.apple.routined/",
    "/wireless/Library/Preferences/com.apple.commcenter",
    "/MobileSoftwareUpdate/"
  ],
  "database_patterns": [
    "sms.db",
    "AddressBook.sqlitedb",
    "CallHistory.storedata",
    "History.db",
    "healthdb_secure.sqlite",
    "healthdb.sqlite",
    "Accounts3.sqlite",
    "interactionC.db",
    "Cache.sqlite",
    "Cloud.sqlite",
    "Cloud-V2.sqlite",
    "passes23.sqlite",
    "SiriAnalytics.db",
    "Recordings.db",
    "CurrentPowerlog.PLSQL",
    "RMAdminStore-Local.sqlite",
    "cache_encryptedA.db",
    "cache_encryptedB.db",
    "Web Data",
    "Login Data",
    "Shortcuts",
    "Network Action Predictor",
    "Affiliation Database",
    "Extension Cookies",
    "signons.sqlite",
    "key4.db",
    "cert9.db",
    "content-prefs.sqlite",
    "permissions.sqlite",
    "contacts2.db",
    "telephony.db",
    "mmssms.db",
    "calendar.db",
    "accounts.db",
    "WebCacheV01.dat",
    "ActivitiesCache.db",
    "Amcache.hve",
    "knowledgeC.db"
  ],
  "plist_delete_files": [
    "com.apple.wifi.plist",
    "com.apple.wifi.known-networks.plist",
    "com.apple.wifi-private-mac-oui-data.plist",
    "com.apple.wifi.sharing.plist"
  ],
  "extension_patterns": [
    {
      "ext": ".jpg",
      "scope": "/var/mobile/"
    },
    {
      "ext": ".jpeg",
      "scope": "/var/mobile/"
    },
    {
      "ext": ".heic",
      "scope": "/var/mobile/"
    },
    {
      "ext": ".heif",
      "scope": "/var/mobile/"
    },
    {
      "ext": ".mov",
      "scope": "/var/mobile/"
    },
    {
      "ext": ".mp4",
      "scope": "/var/mobile/"
    },
    {
      "ext": ".m4v",
      "scope": "/var/mobile/"
    },
    {
      "ext": ".aac",
      "scope": "/var/mobile/"
    },
    {
      "ext": ".m4a",
      "scope": "/var/mobile/"
    },
    {
      "ext": ".3gp",
      "scope": "/var/mobile/"
    }
  ],
  "app_container_delete": {
    "_comment": "Delete all third-party app containers except jailbreak apps",
    "base_path": "/mobile/Containers/Data/Application/",
    "preserve_apps": [
      "Dopamine",
      "Sileo",
      "NewTerm",
      "Filza",
      "weightBufs"
    ]
  }
}
